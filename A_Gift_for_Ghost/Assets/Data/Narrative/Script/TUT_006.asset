  m_Script: {fileID: 11500000, guid: 426166e6124daec4899b884a5cf53037, type: 3}
  m_Name: TUT_006
  m_EditorClassIdentifier: Assembly-CSharp::Ghost.Narrative.DialogueSequence
  startDelay: 0
  lines:
  - id: TUT_006
    speaker: 3
    channel: 2
    text: "\u5C1D\u8BD5\u89E3\u51B3\u5931\u8D25\u3002\u5F53\u524D\u6743\u9650\u4E0B\u6CA1\u6709\u53EF\u6267\u884C\u7684\u65B9\u6848\uFF0C\u7A0D\u540E\u91CD\u8BD5\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_007
    speaker: 0
    channel: 1
    text: "\u4F46\u603B\u6709\u4E00\u4E9B\u65F6\u5019\uFF0C\u5F53\u7529\u624B\u638C\u67DC\u89E3\u51B3\u4E0D\u4E86\u95EE\u9898\u3002\u5F53\u8282\u70B9\u4ECD\u5728\u95EA\u70C1\uFF0C\u5C31\u610F\u5473\u7740\u4E5F\u8BB8\u8FD9\u65F6\uFF0C\u4F60\u8BE5\u4E3B\u52A8\u4ECB\u5165\u4E00\u4E0B\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_008
    speaker: 0
    channel: 1
    text: "\u53F3\u952E\u70B9\u51FB\u53EF\u4EE5\u67E5\u770B\u4EFB\u52A1\u8BE6\u60C5\uFF0C\u4E0D\u8FC7\u5B83\u4EEC\u7ECF\u8FC7\u4E86agent\u7684\u81EA\u52A8\u538B\u7F29\uFF0C\u4E5F\u8BB8\u73B0\u5728\u7684\u4F60\u8FD8\u60F3\u4E0D\u8D77\u5177\u4F53\u7684\u7EC6\u8282\u2014\u2014\u91CD\u65B0\u5EFA\u7ACB\u5BF9\u771F\u5B9E\u7684\u8BA4\u77E5\u662F\u4E00\u4E2A\u9700\u8981\u65F6\u95F4\u7684\u8FC7\u7A0B\u3002\u8BD5\u7740\u53F3\u952E\u8FD9\u4E2A\u8282\u70B9\uFF0C\u770B\u770B\u73B0\u5728\u7684\u4F60\u80FD\u770B\u5230\u591A\u5C11\u5427\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
