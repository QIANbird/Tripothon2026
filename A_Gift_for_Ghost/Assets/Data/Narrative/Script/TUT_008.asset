  m_Script: {fileID: 11500000, guid: 426166e6124daec4899b884a5cf53037, type: 3}
  m_Name: TUT_008
  m_EditorClassIdentifier: Assembly-CSharp::Ghost.Narrative.DialogueSequence
  startDelay: 0
  lines:
  - id: TUT_008
    speaker: 3
    channel: 3
    text: "Mission Failed\u3002\u91CD\u8BD5\u8D85\u65F6\uFF0C\u8FDB\u7A0B\u5DF2\u79BB\u7EBF\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_009
    speaker: 3
    channel: 2
    text: "\u95EE\u9898\u5206\u6790\u2026\u2026\u672A\u627E\u5230\uFF1B\u5DF2\u63D0\u4EA4\u9519\u8BEF\u62A5\u544A\u5E76\u79FB\u5165\u5F85\u5BA1\u67E5\u5F02\u5E38\u5E8F\u5217\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_010
    speaker: 0
    channel: 1
    text: "\u4F46\u603B\u6709\u4E00\u4E9B\u65F6\u5019\uFF0C\u901A\u7528\u7684\u903B\u8F91\u4E0E\u62BD\u8C61\u7ECF\u9A8C\u89E3\u51B3\u4E0D\u4E86\u95EE\u9898\u3002\u5982\u679C\u8282\u70B9\u7EE7\u7EED\u95EA\u70C1\uFF0C\u5C31\u610F\u5473\u7740\u5F02\u5E38\u4ECD\u5728\u629B\u51FA\u3002"
    clip: {fileID: 8300000, guid: 28b2589c3d978a143a09652b5f976a81, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_011
    speaker: 0
    channel: 1
    text: "\u8FD9\u4FBF\u662F\u9700\u8981\u4F60\u4E3B\u52A8\u4ECB\u5165\u7684\u65F6\u5019\u4E86\u3002\u7528\u66F4\u539F\u59CB\u7684\u529E\u6CD5\u6253\u635E\u66F4\u539F\u59CB\u7684\u4FE1\u606F\uFF1B\u89E3\u51B3\u4E4B\u9053\uFF0C\u5F80\u5F80\u5C31\u5728\u5176\u4E2D\u3002"
    clip: {fileID: 8300000, guid: b6eddaba235095444ae35fdac38f43f4, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_012
    speaker: 0
    channel: 1
    text: "\u53F3\u952E\u70B9\u51FB\u8282\u70B9\u53EF\u4EE5\u67E5\u770B\u4EFB\u52A1\u8BE6\u60C5\uFF0C\u4E0D\u8FC7\u5B83\u4EEC\u7ECF\u8FC7\u4E86agent\u7684\u81EA\u52A8\u538B\u7F29\uFF0C\u4E5F\u8BB8\u73B0\u5728\u7684\u4F60\u8FD8\u60F3\u4E0D\u8D77\u5177\u4F53\u7684\u7EC6\u8282\u2014\u2014\u91CD\u65B0\u5EFA\u7ACB\u5BF9\u771F\u5B9E\u7684\u8BA4\u77E5\u662F\u4E00\u4E2A\u9700\u8981\u65F6\u95F4\u7684\u8FC7\u7A0B\u3002"
    clip: {fileID: 8300000, guid: b57d5add82060204fbcd9df144d54100, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_013
    speaker: 0
    channel: 1
    text: "\u8BA9\u6211\u4EEC\u6765\u770B\u770B\u4F60\u8D70\u4E86\u591A\u8FDC\u3002"
    clip: {fileID: 8300000, guid: 8a256703596d6d244afb3bb8e9946f7d, type: 3}
    durationOverride: 0
    pauseAfter: -1
