  m_Script: {fileID: 11500000, guid: 426166e6124daec4899b884a5cf53037, type: 3}
  m_Name: S2_001
  m_EditorClassIdentifier: Assembly-CSharp::Ghost.Narrative.DialogueSequence
  startDelay: 0
  lines:
  - id: S2_001
    speaker: 3
    channel: 2
    text: "\u67B6\u6784\u89C6\u56FE\u6B63\u5728\u5C55\u5F00\u2026\u2026"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_002
    speaker: 3
    channel: 2
    text: "\u9879\u76EE\u4EA7\u80FD\u5F02\u5E38\uFF0C\u81EA\u52A8\u7EF4\u62A4\u7A0B\u5E8F\u505C\u6B62\uFF0C\u6B63\u5728\u5C1D\u8BD5\u81EA\u68C0\u2026\u2026"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_003
    speaker: 3
    channel: 2
    text: "\u672A\u53D1\u73B0\u95EE\u9898\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_004
    speaker: 3
    channel: 2
    text: "\u65E0\u6CD5\u8FFD\u8E2A\u5F02\u5E38\u6765\u6E90\u3002\u81EA\u52A8\u7EF4\u62A4\u91CD\u542F\u5931\u8D25\u3002\u5C1D\u8BD5\u91CD\u65B0\u5206\u6790\u2026\u2026"
    clip: {fileID: 8300000, guid: 47b99b727d9bdf6439af1fba685c1047, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_005
    speaker: 0
    channel: 1
    text: "\u90A3\u4E9B\u771F\u6B63\u8574\u85CF\u7740\u95EE\u9898\u6839\u6E90\u7684\u4FE1\u606F\uFF0C\u5728\u538B\u7F29\u8FC7\u7A0B\u4E2D\u88ABagent\u4E22\u5F03\u4E86\u3002"
    clip: {fileID: 8300000, guid: d172bb1df67e35345b4c2e58e42e33ed, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_006
    speaker: 0
    channel: 1
    text: "\u8BF7\u4F60\u4ED4\u7EC6\u89C2\u5BDF\u90A3\u4E9B\u88AB\u4F60\u6CE8\u610F\u5230\u800C\u4FDD\u7559\u4E0B\u6765\u7684\u79BB\u6563\u6A21\u5757\uFF0C"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_007
    speaker: 0
    channel: 1
    text: "\u5C06\u5B83\u4EEC\u63D2\u5165\u5230\u6B63\u786E\u7684\u4F4D\u7F6E\u5427\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
