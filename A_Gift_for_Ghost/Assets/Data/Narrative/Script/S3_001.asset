  m_Script: {fileID: 11500000, guid: 426166e6124daec4899b884a5cf53037, type: 3}
  m_Name: S3_001
  m_EditorClassIdentifier: Assembly-CSharp::Ghost.Narrative.DialogueSequence
  startDelay: 0
  lines:
  - id: S3_001
    speaker: 3
    channel: 2
    text: "\u5DF2\u5728\u672C\u6982\u5FF5\u5C42\u5C55\u5F00\u91CD\u65B0\u5206\u6790\u3002\u626B\u63CF\u5168\u5C40\u72B6\u6001\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S3_002
    speaker: 3
    channel: 2
    text: "\u5DF2\u91CD\u65B0\u4FEE\u6B63\u95EE\u9898\u5B9A\u4F4D\uFF1B\u68C0\u6D4B\u5230\u5C40\u90E8\u6D41\u91CF\u5F02\u5E38\uFF0C\u63A8\u6D4B\u4E3A\u6728\u9A6C\u6D3B\u52A8\u3002\u8FDB\u5165\u4EBA\u5DE5\u786E\u8BA4\u7A0B\u5E8F\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S3_003
    speaker: 3
    channel: 3
    text: "RGB\u6A21\u5F0F\u5DF2\u6062\u590D\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S3_004
    speaker: 3
    channel: 3
    text: "\u7A7A\u95F4\u89C6\u89C9\u5DF2\u6062\u590D\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S3_005
    speaker: 3
    channel: 2
    text: "\u7A7A\u767D\u5904\u62D6\u62FD\u53EF\u89C2\u5BDF\u5230\u626B\u63CF\u6B7B\u89D2\uFF0C\u53F3\u952E\u67E5\u770B\u8BE6\u7EC6\u4FE1\u606F\uFF0C\u5224\u65AD\u4E3A\u5F02\u5E38\u8282\u70B9\u65F6\uFF0C\u8BF7\u70B9\u51FB\u6807\u8BB0\u8BE5\u53EF\u7591\u8282\u70B9\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
