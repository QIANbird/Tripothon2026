  lines:
  - id: S1_002
    speaker: 3
    channel: 2
    text: "\u6838\u5FC3\u9879\u76EE\uFF1A\u672C\u5468\u671F\u8FDB\u5EA6\u843D\u540E\n\u5EFA\u8BAE\u64CD\u4F5C\uFF1A\u63D0\u9AD8\u6267\u884C\u5F3A\u5EA6"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S1_003
    speaker: 0
    channel: 1
    text: "\u770B\u8D77\u6765\u4F60\u5DF2\u7ECF\u5177\u5907\u4E86\u6700\u57FA\u672C\u7684\u4FE1\u606F\u5904\u7406\u80FD\u529B\uFF0C\u4F46\u662F\u6709\u4E9B\u4E8B\u60C5\u76F4\u63A5\u4EA4\u7ED9agent\u65E0\u6CD5\u89E3\u51B3\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S1_004
    speaker: 0
    channel: 1
    text: "\u73B0\u5728\u6211\u4EEC\u5C06\u6DF1\u5165\u8FD9\u4E9B\u5904\u7406\u5668\u770B\u770B\u3002"
