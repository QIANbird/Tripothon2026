  - id: S1_002
    speaker: 3
    channel: 0
    text: "\u6838\u5FC3\u9879\u76EE\uFF1A\u672C\u5468\u671F\u8FDB\u5EA6\u843D\u540E\n\u5EFA\u8BAE\u64CD\u4F5C\uFF1A\u63D0\u9AD8\u6267\u884C\u5F3A\u5EA6"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S1_003
    speaker: 0
    channel: 1
    text: "\u770B\u8D77\u6765\u6211\u4EEC\u53D1\u73B0\u4E86\u4E00\u4E9B\u987D\u56FA\u7684\u95EE\u9898\uFF0C\u4F46\u8FD9\u90FD\u662F\u4E9B\u662F\u4EC0\u4E48\uFF1F"
    clip: {fileID: 8300000, guid: e60aa0b3dde01d34a83bdd060501e260, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: S1_004
    speaker: 0
    channel: 1
    text: "\u8BA9\u6211\u4EEC\u8FDB\u4E00\u6B65\u5C55\u5F00\u88AB\u538B\u7F29\u7684\u4FE1\u606F\u3002"
