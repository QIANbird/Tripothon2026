  startDelay: 0
  lines:
  - id: S2_001
    speaker: 3
    channel: 2
    text: "\u5173\u8054\u89C6\u56FE\u6B63\u5728\u5C55\u5F00\u2026\u2026"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_002
    speaker: 3
    channel: 2
    text: "\u95EE\u9898\u5B9A\u4F4D\uFF1A\u589E\u957F\u7F13\u6EDE\uFF0C\u6211\u5224\u65AD\u4E3A\u8D44\u6E90\u4F9B\u5E94\u4E0D\u8DB3\u3002\u4F9B\u7ED9\u9700\u8981\u4ECE\u652F\u6491\u7CFB\u7EDF\u5F00\u59CB\u5206\u914D\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_003
    speaker: 0
    channel: 1
    text: "\u770B\u8D77\u6765\u8FD9\u91CC\u6709\u4E24\u4E2A\u672C\u8BE5\u8FDE\u63A5\u7684\u7CFB\u7EDF\u65AD\u5F00\u4E86\uFF0Cagent\u6709\u65F6\u65E0\u6CD5\u7BA1\u7406\u597D\u6574\u4E2A\u7CFB\u7EDF\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_004
    speaker: 0
    channel: 2
    text: "\u8BF7\u4F60\u4EB2\u81EA\u94FE\u63A5\u8FD9\u4E9B\u5F02\u5E38\u8282\u70B9\u5427\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
