  m_Script: {fileID: 11500000, guid: 426166e6124daec4899b884a5cf53037, type: 3}
  m_Name: S2_001
  m_EditorClassIdentifier: Assembly-CSharp::Ghost.Narrative.DialogueSequence
  startDelay: 0
  lines:
  - id: S2_001
    speaker: 3
    channel: 2
    text: "\u5173\u8054\u89C6\u56FE\u6B63\u5728\u5C55\u5F00\u2026\u2026"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_002
    speaker: 3
    channel: 2
    text: "\u5DF2\u5728\u672C\u6982\u5FF5\u5C42\u5C55\u5F00\u91CD\u65B0\u5206\u6790\u3002\u626B\u63CF\u5168\u5C40\u72B6\u6001\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_003
    speaker: 3
    channel: 2
    text: "\u95EE\u9898\u5B9A\u4F4D\uFF1A\u8FDC\u7AEF\u751F\u4EA7\u7CFB\u7EDF\u589E\u957F\u7F13\u6EDE\uFF0C\u5224\u65AD\u9996\u8981\u53EF\u80FD\u6027\u4E3A\u4F9B\u7ED9\u5C42\u8D44\u6E90\u4F9B\u5E94\u4E0D\u8DB3\u3002\u5EFA\u8BAE\u4ECE\u652F\u6491\u7CFB\u7EDF\u5F00\u59CB\u4FEE\u590D\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_004
    speaker: 0
    channel: 1
    text: "\u770B\u6765\u4F60\u7684Agent\u5728\u7CFB\u7EDF\u5C42\u9762\u7684\u67B6\u6784\u8BBE\u8BA1\u4E0A\u4ECD\u7136\u6709\u6240\u77ED\u677F\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: S2_005
    speaker: 0
    channel: 1
    text: "\u770B\u8D77\u6765\u8FD9\u91CC\u6709\u4E24\u4E2A\u672C\u8BE5\u8FDE\u63A5\u7684\u7CFB\u7EDF\u65AD\u5F00\u4E86\uFF0C\u8BF7\u4F60\u4ED4\u7EC6\u89C2\u5BDF\u5E76\u56DE\u60F3\u5982\u4F55\u4FEE\u590D\u8FD9\u4E9B\u5F02\u5E38\u8282\u70B9\u5427\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
