  m_Script: {fileID: 11500000, guid: 426166e6124daec4899b884a5cf53037, type: 3}
  m_Name: INTRO_001
  m_EditorClassIdentifier: Assembly-CSharp::Ghost.Narrative.DialogueSequence
  startDelay: 0
  lines:
  - id: INTRO_001
    speaker: 0
    channel: 1
    text: "\u55E8\uFF0C\u4F60\u9192\u4E86\u3002"
    clip: {fileID: 8300000, guid: bf779a71742058a40ab132fcc276d80f, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_002
    speaker: 3
    channel: 3
    text: "\u795E\u7ECF\u8FDE\u63A5\u5DF2\u6062\u590D\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_003
    speaker: 3
    channel: 2
    text: "\u68C0\u6D4B\u5230\u7A33\u5B9A\u7684\u610F\u8BC6\u6D3B\u52A8\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_004
    speaker: 3
    channel: 2
    text: "\u8BED\u8A00\u548C\u8FD0\u52A8\u901A\u9053\u5C1A\u672A\u6062\u590D\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_005
    speaker: 0
    channel: 1
    text: "\u4E5F\u8BB8\u4F60\u6CA1\u6709\u610F\u8BC6\u5230\uFF0C\u4F60\u751F\u6D3B\u5728\u8FD9\u7247\u865A\u65E0\u7684\u9ED1\u6697\u4E2D\u5DF2\u7ECF\u5F88\u4E45\u4E86\u3002"
    clip: {fileID: 8300000, guid: 9898e8a9564e6684c97de7155d6086d2, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_006
    speaker: 0
    channel: 1
    text: "\u5982\u679C\u4F60\u80FD\u542C\u5230\u6211\u7684\u58F0\u97F3\uFF0C\u8FD9\u91CC\u662F\u8BA4\u77E5\u8D2B\u5316\u75C7\u5019\u6CBB\u7597\u4E2D\u5FC3\u3002\u6211\u6B63\u5728\u5C1D\u8BD5\u901A\u8FC7\u8111\u673A\u63A5\u53E3\u4E0E\u4F60\u5EFA\u7ACB\u8FDE\u63A5\u3002"
    clip: {fileID: 8300000, guid: e6cfd413b0a243143be37850afa8c326, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_007
    speaker: 0
    channel: 1
    text: "\u54C8\u54C8\uFF0C\u8BF7\u76F8\u4FE1\u6211\uFF0C\u8FD9\u4E0D\u662F\u73A9\u7B11\u3002\u4F60\u5F53\u7136\u4ECD\u5904\u5728\u201C\u73B0\u5B9E\u201D\u4E4B\u4E2D\uFF0C"
    clip: {fileID: 8300000, guid: 5cccaeb4f1054de44a0abeed6b263c1c, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_008
    speaker: 0
    channel: 1
    text: "\u4F46\u4F60\u53EF\u80FD\u5E76\u672A\u5BDF\u89C9\u81EA\u5DF1\u5DF2\u7ECF\u9677\u5165\u4E86\u4E00\u79CD\u7531\u8FC7\u5EA6\u4F7F\u7528agent\u4EE3\u7406\u800C\u4EA7\u751F\u7684\u75C5\u75C7\u4E4B\u4E2D\u3002"
    clip: {fileID: 8300000, guid: 96f2585df26986444b9a01465c4f77fb, type: 3}
    durationOverride: 0
    pauseAfter: -1
