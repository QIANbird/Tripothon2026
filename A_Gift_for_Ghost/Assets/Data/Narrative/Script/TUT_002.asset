    durationOverride: 0
    pauseAfter: -1
  - id: TUT_003
    speaker: 0
    channel: 1
    text: "\u9009\u4E2D\u5F02\u5E38\u8282\u70B9\uFF0C\u518D\u6309\u4E0B\u63D0\u4EA4\u786E\u8BA4\uFF0C\u5373\u6279\u51C6agent\u5BF9\u5176\u8FDB\u884C\u4E00\u6B21\u81EA\u52A8\u5904\u7406\u3002"
