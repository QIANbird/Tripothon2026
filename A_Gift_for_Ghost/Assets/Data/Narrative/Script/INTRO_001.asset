  m_Script: {fileID: 11500000, guid: 426166e6124daec4899b884a5cf53037, type: 3}
  m_Name: INTRO_001
  m_EditorClassIdentifier: Assembly-CSharp::Ghost.Narrative.DialogueSequence
  startDelay: 0
  lines:
  - id: INTRO_001
    speaker: 0
    channel: 1
    text: "\u55E8\uFF0C\u4F60\u9192\u4E86\u3002"
    clip: {fileID: 8300000, guid: bf779a71742058a40ab132fcc276d80f, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_002
    speaker: 3
    channel: 3
    text: "\u795E\u7ECF\u8FDE\u63A5\u5DF2\u6062\u590D\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_003
    speaker: 3
    channel: 2
    text: "\u68C0\u6D4B\u5230\u7A33\u5B9A\u7684\u610F\u8BC6\u6D3B\u52A8\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_004
    speaker: 3
    channel: 2
    text: "\u8BED\u8A00\u548C\u8FD0\u52A8\u901A\u9053\u5C1A\u672A\u6062\u590D\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_005
    speaker: 0
    channel: 1
    text: "\u4E5F\u8BB8\u4F60\u6CA1\u6709\u610F\u8BC6\u5230\uFF0C\u4F60\u751F\u6D3B\u5728\u8FD9\u7247\u865A\u65E0\u7684\u9ED1\u6697\u4E2D\u5DF2\u7ECF\u5F88\u4E45\u4E86\u3002"
    clip: {fileID: 8300000, guid: 9898e8a9564e6684c97de7155d6086d2, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_006
    speaker: 0
    channel: 1
    text: "\u5982\u679C\u4F60\u80FD\u542C\u5230\u6211\u7684\u58F0\u97F3\uFF0C\u8FD9\u91CC\u662F\u8BA4\u77E5\u8D2B\u5316\u75C7\u5019\u6CBB\u7597\u4E2D\u5FC3\u3002\u6709\u5F88\u591A\u4EBA\u5728\u5173\u5FC3\u4F60\u7684\u72B6\u51B5\u3002"
    clip: {fileID: 8300000, guid: e6cfd413b0a243143be37850afa8c326, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_007
    speaker: 0
    channel: 1
    text: "\u2026\u2026\u4E0D\uFF0C\u8FD9\u4E0D\u662F\u73A9\u7B11\u3002\u4F60\u5F53\u7136\u4ECD\u5904\u5728\u201C\u73B0\u5B9E\u201D\u4E4B\u4E2D\uFF0C"
    clip: {fileID: 8300000, guid: 5cccaeb4f1054de44a0abeed6b263c1c, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: INTRO_008
    speaker: 0
    channel: 1
    text: "\u4F46\u7531\u4E8E\u4F60\u957F\u4E45\u4EE5\u6765\u4F7F\u7528agent\u8FC7\u5EA6\u4EE3\u7406\u4E0E\u73B0\u5B9E\u4E16\u754C\u4FE1\u606F\u4EA4\u4E92\uFF0C\u611F\u5B98\u4E0E\u795E\u7ECF\u673A\u80FD\u51FA\u73B0\u4E86\u4E25\u91CD\u9000\u5316\u2014\u2014\u4E5F\u5C31\u662F\u73B0\u5728\u5927\u6D41\u884C\u7684\u201C\u8BA4\u77E5\u8D2B\u5316\u75C7\u201D\uFF0C\u5927\u8111\u5931\u53BB\u4E86\u91CD\u5EFA\u771F\u5B9E\u4E16\u754C\u7684\u80FD\u529B\u3002\u6211\u76EE\u524D\u6B63\u5728\u5C1D\u8BD5\u901A\u8FC7\u8111\u673A\u63A5\u53E3\u4E0E\u4F60\u5EFA\u7ACB\u8FDE\u63A5\u3002"
    clip: {fileID: 8300000, guid: 96f2585df26986444b9a01465c4f77fb, type: 3}
    durationOverride: 0
    pauseAfter: -1
