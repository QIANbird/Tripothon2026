  m_Script: {fileID: 11500000, guid: 426166e6124daec4899b884a5cf53037, type: 3}
  m_Name: TUT_008
  m_EditorClassIdentifier: Assembly-CSharp::Ghost.Narrative.DialogueSequence
  startDelay: 0
  lines:
  - id: TUT_008
    speaker: 3
    channel: 3
    text: "Mission Failed\u3002\u91CD\u8BD5\u8D85\u65F6\uFF0C\u8FDB\u7A0B\u5DF2\u79BB\u7EBF\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_009
    speaker: 3
    channel: 2
    text: "\u95EE\u9898\u5206\u6790\u2026\u2026\u672A\u627E\u5230\uFF1B\u5DF2\u63D0\u4EA4\u9519\u8BEF\u62A5\u544A\u5E76\u79FB\u5165\u5F85\u5BA1\u67E5\u5F02\u5E38\u5E8F\u5217\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_010
    speaker: 0
    channel: 1
    text: "\u4F46\u603B\u6709\u4E00\u4E9B\u65F6\u5019\uFF0C\u5B83\u7684\u5168\u80FD\u4E5F\u6709\u758F\u6F0F\u3002\u8282\u70B9\u5F00\u59CB\u518D\u6B21\u95EA\u70C1\uFF0C\u610F\u5473\u7740\u5373\u4FBFagent\u7684\u8FD9\u6B21\u5C1D\u8BD5\u6CA1\u6709\u771F\u6B63\u89E3\u51B3\u95EE\u9898\u3002"
    clip: {fileID: 8300000, guid: ad67d3b4516564b4ab51433123eec848, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_011
    speaker: 0
    channel: 1
    text: "\u8FD9\u4FBF\u662F\u9700\u8981\u4F60\u4E3B\u52A8\u4ECB\u5165\u7684\u65F6\u5019\u4E86\u3002"
    clip: {fileID: 8300000, guid: 5eaa136438a3dcf459bf77129a59d0e1, type: 3}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_012
    speaker: 0
    channel: 1
    text: "\u9009\u4E2D\u8282\u70B9\u540E\uFF0C\u9664\u4E86\u5411agent\u76F4\u63A5\u63D0\u4EA4\uFF0C\u4E5F\u53EF\u4EE5\u81EA\u5DF1\u67E5\u770B\u4EFB\u52A1\u8BE6\u60C5\u3002"
    clip: {fileID: 8300000, guid: 7bac7ec808aa83f4793a576e1d136cc5, type: 3}
    durationOverride: 0
    pauseAfter: -1
