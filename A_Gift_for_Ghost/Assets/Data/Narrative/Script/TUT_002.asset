    text: "\u770B\u5230\u90A3\u4E2A\u95EA\u70C1\u7684\u65B9\u5757\u4E86\u5417\uFF1F\u8FD9\u662F\u4E00\u4E2A\u88AB\u9AD8\u5EA6\u538B\u7F29\u8FC7\u7684\u4FE1\u606F\u5355\u5143\uFF0C\u5B83\u4EE3\u8868\u7740\u4F60\u73B0\u5B9E\u4E16\u754C\u751F\u6D3B\u4E2D\u7684\u4E00\u9879\u5177\u4F53\u4E8B\u52A1\uFF0C\u5728\u8FD9\u91CC\u90FD\u4F1A\u663E\u793A\u4E3A\u91CF\u5316\u597D\u7684\u5F85\u5904\u7406\u4EFB\u52A1\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - id: TUT_003
    speaker: 0
    channel: 1
    text: "\u70B9\u51FB\u5F02\u5E38\u8282\u70B9\uFF0C\u5373\u6279\u51C6agent\u5BF9\u5176\u8FDB\u884C\u4E00\u6B21\u81EA\u52A8\u5904\u7406\u3002"
