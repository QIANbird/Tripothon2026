    text: "RGB\u6A21\u5F0F\u5DF2\u6062\u590D\u3002\u8BF7\u4ED4\u7EC6\u7504\u522B\u6765\u81EA\u7CFB\u7EDF\u5916\u7684\u5165\u4FB5\u5E72\u6270\u3002"
