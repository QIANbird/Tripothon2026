  startDelay: 0.8
  lines:
  - speaker: 0
    text: "[\u5360\u4F4D] \u989C\u8272\u56DE\u6765\u4E86\u3002\u4ED4\u7EC6\u770B\uFF0C\u6709\u4E9B\u4E1C\u897F\u4E0D\u5C5E\u4E8E\u8FD9\u682A\u690D\u7269\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - speaker: 0
    text: "[\u5360\u4F4D] \u5728\u7A7A\u767D\u5904\u6309\u4F4F\u62D6\u52A8\uFF0C\u53EF\u4EE5\u8F6C\u52A8\u5B83\u3002\u53F6\u5B50\u80CC\u9762\u4E5F\u770B\u770B\u3002"
    clip: {fileID: 0}
    durationOverride: 0
    pauseAfter: -1
  - speaker: 3
    text: "[\u5360\u4F4D] \u70B9\u51FB\u53EF\u7591\u8282\u70B9\u8FDB\u884C\u6807\u8BB0\u3002"
