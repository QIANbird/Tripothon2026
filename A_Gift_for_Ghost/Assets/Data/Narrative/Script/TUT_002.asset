    text: "\u770B\u5230\u90A3\u4E2A\u95EA\u70C1\u7684\u65B9\u5757\u4E86\u5417\uFF1F\u8FD9\u662F\u4E00\u4E2A\u88AB\u9AD8\u5EA6\u538B\u7F29\u8FC7\u7684\u4FE1\u606F\u5355\u5143\uFF0C\u5B83\u4EE3\u8868agent\u4E3A\u4F60\u51C6\u5907\u597D\u7684\u5F85\u529E\u4E8B\u9879\u3002"
